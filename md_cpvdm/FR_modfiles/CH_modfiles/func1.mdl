N2HDM_CPVDM
 Constraints
  Name         |> Expression                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <|
%*slhaFound    |1+access("vars1.lha", 0)                                                                                       %Check whether LHA file is present.
%*rdSLHA       |if(slhaFound,slhaRead("vars1.lha", 0),-1)                                                                      %Read LHA file.
%MZ            |if(slhaFound,if(slhaValExists("FRBlock",1,1),slhaVal("FRBlock",0,1,1),MZDef),MZDef)                            %Z pole mas                                        
%aEWM1         |if(slhaFound,if(slhaValExists("FRBlock",1,2),slhaVal("FRBlock",0,1,2),aEWM1Def),aEWM1Def)                      %EW coupling constant at the Z pole                
%Gf            |if(slhaFound,if(slhaValExists("FRBlock",1,3),slhaVal("FRBlock",0,1,3),GfDef),GfDef)                            %Fermi constant                                    
%aS            |if(slhaFound,if(slhaValExists("FRBlock",1,4),slhaVal("FRBlock",0,1,4),aSDef),aSDef)                            %Strong coupling constant at the Z pole.           
%mHsm          |if(slhaFound,if(slhaValExists("FRBlock",1,5),slhaVal("FRBlock",0,1,5),mHsmDef),mHsmDef)                        %SM-like Higgs boson mass                          
%mG0           |if(slhaFound,if(slhaValExists("FRBlock",1,6),slhaVal("FRBlock",0,1,6),mG0Def),mG0Def)                          %SM-like Higgs boson mass                          
%mGch          |if(slhaFound,if(slhaValExists("FRBlock",1,7),slhaVal("FRBlock",0,1,7),mGchDef),mGchDef)                        %SM-like Higgs boson mass                          
%mHc           |if(slhaFound,if(slhaValExists("FRBlock",1,8),slhaVal("FRBlock",0,1,8),mHcDef),mHcDef)                          %Charged scalar mass                               
%alph1         |if(slhaFound,if(slhaValExists("FRBlock",1,9),slhaVal("FRBlock",0,1,9),alph1Def),alph1Def)                      %Dark-Scalar mixing angle                          
%alph2         |if(slhaFound,if(slhaValExists("FRBlock",1,10),slhaVal("FRBlock",0,1,10),alph2Def),alph2Def)                    %Dark-Scalar mixing angle                          
%alph3         |if(slhaFound,if(slhaValExists("FRBlock",1,11),slhaVal("FRBlock",0,1,11),alph3Def),alph3Def)                    %Dark-Scalar mixing angle                          
%mH1           |if(slhaFound,if(slhaValExists("FRBlock",1,12),slhaVal("FRBlock",0,1,12),mH1Def),mH1Def)                        %first BSM scalar mass                             
%mH2           |if(slhaFound,if(slhaValExists("FRBlock",1,13),slhaVal("FRBlock",0,1,13),mH2Def),mH2Def)                        %second BSM scalar mass                            
%m22sq         |if(slhaFound,if(slhaValExists("FRBlock",1,14),slhaVal("FRBlock",0,1,14),m22sqDef),m22sqDef)                    %Inert doublet mass parameter                      
%mssq          |if(slhaFound,if(slhaValExists("FRBlock",1,15),slhaVal("FRBlock",0,1,15),mssqDef),mssqDef)                      %Inert singlet mass parameter                      
%L1            |if(slhaFound,if(slhaValExists("FRBlock",1,16),slhaVal("FRBlock",0,1,16),L1Def),L1Def)                          %SM-like Higgs self coupling                       
%L2            |if(slhaFound,if(slhaValExists("FRBlock",1,17),slhaVal("FRBlock",0,1,17),L2Def),L2Def)                          %Inert Doublet self coupling                       
%L3            |if(slhaFound,if(slhaValExists("FRBlock",1,18),slhaVal("FRBlock",0,1,18),L3Def),L3Def)                          %L3                                                
%L4            |if(slhaFound,if(slhaValExists("FRBlock",1,19),slhaVal("FRBlock",0,1,19),L4Def),L4Def)                          %L4                                                
%L5            |if(slhaFound,if(slhaValExists("FRBlock",1,20),slhaVal("FRBlock",0,1,20),L5Def),L5Def)                          %L5                                                
%L6            |if(slhaFound,if(slhaValExists("FRBlock",1,21),slhaVal("FRBlock",0,1,21),L6Def),L6Def)                          %Inert singlet self coupling                       
%L7            |if(slhaFound,if(slhaValExists("FRBlock",1,22),slhaVal("FRBlock",0,1,22),L7Def),L7Def)                          %L7                                                
%L8            |if(slhaFound,if(slhaValExists("FRBlock",1,23),slhaVal("FRBlock",0,1,23),L8Def),L8Def)                          %Inert sector quartic mixing                       
%Treal         |if(slhaFound,if(slhaValExists("FRBlock",1,24),slhaVal("FRBlock",0,1,24),TrealDef),TrealDef)                    %Treal                                             
%Timag         |if(slhaFound,if(slhaValExists("FRBlock",1,25),slhaVal("FRBlock",0,1,25),TimagDef),TimagDef)                    %Timag                                             
%ME            |if(slhaFound,if(slhaValExists("FRBlock",1,26),slhaVal("FRBlock",0,1,26),MEDef),MEDef)                          %neglectable electron mass                         
%MM            |if(slhaFound,if(slhaValExists("FRBlock",1,27),slhaVal("FRBlock",0,1,27),MMDef),MMDef)                          %muon mass                                         
%MTA           |if(slhaFound,if(slhaValExists("FRBlock",1,28),slhaVal("FRBlock",0,1,28),MTADef),MTADef)                        %tauon mass                                        
%MU            |if(slhaFound,if(slhaValExists("FRBlock",1,29),slhaVal("FRBlock",0,1,29),MUDef),MUDef)                          %neglectable up mass                               
%MD            |if(slhaFound,if(slhaValExists("FRBlock",1,30),slhaVal("FRBlock",0,1,30),MDDef),MDDef)                          %neglectable down mass                             
%MS            |if(slhaFound,if(slhaValExists("FRBlock",1,31),slhaVal("FRBlock",0,1,31),MSDef),MSDef)                          %neglectable strange mass                          
%MC            |if(slhaFound,if(slhaValExists("FRBlock",1,32),slhaVal("FRBlock",0,1,32),MCDef),MCDef)                          %c mass at mc, MSbar                               
%MB            |if(slhaFound,if(slhaValExists("FRBlock",1,33),slhaVal("FRBlock",0,1,33),MBDef),MBDef)                          %b mass at mb, MSbar                               
%MT            |if(slhaFound,if(slhaValExists("FRBlock",1,34),slhaVal("FRBlock",0,1,34),MTDef),MTDef)                          %t pole mass                                       
%Mnue          |if(slhaFound,if(slhaValExists("MASS",1,12),slhaVal("MASS",0,1,12),MnueDef),MnueDef)                            %Mass of ve.                                       
%Mnum          |if(slhaFound,if(slhaValExists("MASS",1,14),slhaVal("MASS",0,1,14),MnumDef),MnumDef)                            %Mass of vm.                                       
%Mnut          |if(slhaFound,if(slhaValExists("MASS",1,16),slhaVal("MASS",0,1,16),MnutDef),MnutDef)                            %Mass of vt.                                       
%WT            |if(slhaFound,if(1+slhaDecayExists(6),slhaWidth(6),WTDef),WTDef)                                                %Width of t.                                       
%WZ            |if(slhaFound,if(1+slhaDecayExists(23),slhaWidth(23),WZDef),WZDef)                                              %Width of Z.                                       
%WW            |if(slhaFound,if(1+slhaDecayExists(24),slhaWidth(24),WWDef),WWDef)                                              %Width of W.                                       
%WHsm          |if(slhaFound,if(1+slhaDecayExists(25),slhaWidth(25),WHsmDef),WHsmDef)                                          %Width of h.                                       
%WH1           |if(slhaFound,if(1+slhaDecayExists(35),slhaWidth(35),WH1Def),WH1Def)                                            %Width of H1.                                      
%WH2           |if(slhaFound,if(1+slhaDecayExists(36),slhaWidth(36),WH2Def),WH2Def)                                            %Width of H2.                                      
%WH3           |if(slhaFound,if(1+slhaDecayExists(28),slhaWidth(28),WH3Def),WH3Def)                                            %Width of H3.                                      
%WHc           |if(slhaFound,if(1+slhaDecayExists(37),slhaWidth(37),WHcDef),WHcDef)                                            %Width of Hc.                                      
MW             |pow(pow(MZ,2)/2.+pow(-(aEWM1*Pi*pow(2,-0.5)*pow(Gf,-1)*pow(MZ,2))+pow(MZ,4)/4.,0.5),0.5)                       % W mass                                            
EE             |2*pow(aEWM1,0.5)*pow(Pi,0.5)                                                                                   % Electron charge - Photon coupling to electrons    
CW2            |pow(MW,2)*pow(MZ,-2)                                                                                           % Squared cosine of the weak angle                  
SW2            |1-CW2                                                                                                          % Squared Sin of the weak angle                     
CW             |pow(CW2,0.5)                                                                                                   % Cosine of the weak angle                          
SW             |pow(SW2,0.5)                                                                                                   % Sine of the weak angle                            
g1             |EE*pow(CW,-1)                                                                                                  % U(1)_Y coupling constant                          
g2             |EE*pow(SW,-1)                                                                                                  % SU(2) coupling constant                           
v              |0.8408964152537146*pow(Gf,-0.5)                                                                                % Higgs VEV                                         
RR1x1          |cos(alph1)*cos(alph2)                                                                                          % RR1x1                                             
RR1x2          |cos(alph2)*sin(alph1)                                                                                          % RR1x2                                             
RR1x3          |sin(alph2)                                                                                                     % RR1x3                                             
RR2x1          |-(cos(alph3)*sin(alph1))-cos(alph1)*sin(alph2)*sin(alph3)                                                      % RR2x1                                             
RR2x2          |cos(alph1)*cos(alph3)-sin(alph1)*sin(alph2)*sin(alph3)                                                         % RR2x2                                             
RR2x3          |cos(alph2)*sin(alph3)                                                                                          % RR2x3                                             
RR3x1          |-(cos(alph1)*cos(alph3)*sin(alph2))+sin(alph1)*sin(alph3)                                                      % RR3x1                                             
RR3x2          |-(cos(alph3)*sin(alph1)*sin(alph2))-cos(alph1)*sin(alph3)                                                      % RR3x2                                             
RR3x3          |cos(alph2)*cos(alph3)                                                                                          % RR3x3                                             
mH3            |pow(-((RR1x1*RR1x2*pow(mH1,2)+RR2x1*RR2x2*pow(mH2,2))*pow(RR3x1,-1)*pow(RR3x2,-1)),0.5)                        % third BSM scalar mass                             
m11sq          |-0.5*pow(mHsm,2)                                                                                               % SM-like Higgs mass parameter                      
CKM1x1         |0.97428                                                                                                        % CKM-Matrix ( CKM1x1 )                             
CKM1x2         |0.2253                                                                                                         % CKM-Matrix ( CKM1x2 )                             
CKM1x3         |0.00347                                                                                                        % CKM-Matrix ( CKM1x3 )                             
CKM2x1         |0.2252                                                                                                         % CKM-Matrix ( CKM2x1 )                             
CKM2x2         |0.97345                                                                                                        % CKM-Matrix ( CKM2x2 )                             
CKM2x3         |0.041                                                                                                          % CKM-Matrix ( CKM2x3 )                             
CKM3x1         |0.00862                                                                                                        % CKM-Matrix ( CKM3x1 )                             
CKM3x2         |0.0403                                                                                                         % CKM-Matrix ( CKM3x2 )                             
CKM3x3         |0.999152                                                                                                       % CKM-Matrix ( CKM3x3 )                             
yu1            |MU*pow(2,0.5)*pow(v,-1)                                                                                        % up-type quark Yukawa couplings ( yu1 )            
yu2            |MC*pow(2,0.5)*pow(v,-1)                                                                                        % up-type quark Yukawa couplings ( yu2 )            
yu3            |MT*pow(2,0.5)*pow(v,-1)                                                                                        % up-type quark Yukawa couplings ( yu3 )            
yd1            |MD*pow(2,0.5)*pow(v,-1)                                                                                        % down-type quark Yukawa couplings ( yd1 )          
yd2            |MS*pow(2,0.5)*pow(v,-1)                                                                                        % down-type quark Yukawa couplings ( yd2 )          
yd3            |MB*pow(2,0.5)*pow(v,-1)                                                                                        % down-type quark Yukawa couplings ( yd3 )          
yl1            |ME*pow(2,0.5)*pow(v,-1)                                                                                        % down-type lepton Yukawa couplings ( yl1 )         
yl2            |MM*pow(2,0.5)*pow(v,-1)                                                                                        % down-type lepton Yukawa couplings ( yl2 )         
yl3            |MTA*pow(2,0.5)*pow(v,-1)                                                                                       % down-type lepton Yukawa couplings ( yl3 )         
I1a1           |1                                                                                                              % Abbreviation used in optimizatized FeynRules outpu
I1a2           |1                                                                                                              % Abbreviation used in optimizatized FeynRules outpu
I1a3           |1                                                                                                              % Abbreviation used in optimizatized FeynRules outpu
I2a1           |1                                                                                                              % Abbreviation used in optimizatized FeynRules outpu
I2a2           |1                                                                                                              % Abbreviation used in optimizatized FeynRules outpu
I2a3           |1                                                                                                              % Abbreviation used in optimizatized FeynRules outpu
I3a1           |CKM1x1*yd1+CKM2x1*yd2+CKM3x1*yd3                                                                               % Abbreviation used in optimizatized FeynRules outpu
I3a2           |CKM1x2*yd1+CKM2x2*yd2+CKM3x2*yd3                                                                               % Abbreviation used in optimizatized FeynRules outpu
I3a3           |CKM1x3*yd1+CKM2x3*yd2+CKM3x3*yd3                                                                               % Abbreviation used in optimizatized FeynRules outpu
I4a1           |1                                                                                                              % Abbreviation used in optimizatized FeynRules outpu
I4a2           |1                                                                                                              % Abbreviation used in optimizatized FeynRules outpu
I4a3           |1                                                                                                              % Abbreviation used in optimizatized FeynRules outpu
I5a1           |CKM1x1*yu1+CKM1x2*yu2+CKM1x3*yu3                                                                               % Abbreviation used in optimizatized FeynRules outpu
I5a2           |CKM2x1*yu1+CKM2x2*yu2+CKM2x3*yu3                                                                               % Abbreviation used in optimizatized FeynRules outpu
I5a3           |CKM3x1*yu1+CKM3x2*yu2+CKM3x3*yu3                                                                               % Abbreviation used in optimizatized FeynRules outpu
I6a1           |CKM1x1*yd1+CKM2x1*yd2+CKM3x1*yd3                                                                               % Abbreviation used in optimizatized FeynRules outpu
I6a2           |CKM1x2*yd1+CKM2x2*yd2+CKM3x2*yd3                                                                               % Abbreviation used in optimizatized FeynRules outpu
I6a3           |CKM1x3*yd1+CKM2x3*yd2+CKM3x3*yd3                                                                               % Abbreviation used in optimizatized FeynRules outpu
I7a1           |CKM1x1*yu1+CKM1x2*yu2+CKM1x3*yu3                                                                               % Abbreviation used in optimizatized FeynRules outpu
I7a2           |CKM2x1*yu1+CKM2x2*yu2+CKM2x3*yu3                                                                               % Abbreviation used in optimizatized FeynRules outpu
I7a3           |CKM3x1*yu1+CKM3x2*yu2+CKM3x3*yu3                                                                               % Abbreviation used in optimizatized FeynRules outpu
x1x0           |-3*L1                                                                                                          % Z.f  Z.f  Z.f  Z.f   coupling.
x2x0           |-L1                                                                                                            % Z.f  Z.f  W+.f W-.f  coupling.
x3x0           |-2*L1                                                                                                          % W+.f W+.f W-.f W-.f  coupling.
x4x0           |-L1                                                                                                            % Z.f  Z.f  h    h     coupling.
x5x0           |-L1                                                                                                            % W+.f W-.f h    h     coupling.
x6x0           |-3*L1                                                                                                          % h    h    h    h     coupling.
x7x0           |-2*L2                                                                                                          % ~H+  ~H+  ~H-  ~H-   coupling.
x8x0           |-L3                                                                                                            % Z.f  Z.f  ~H+  ~H-   coupling.
x9x0           |-L3-L4                                                                                                         % W+.f W-.f ~H+  ~H-   coupling.
x10x0          |-L3                                                                                                            % h    h    ~H+  ~H-   coupling.
x11x0          |-2*L5                                                                                                          % W-.f W-.f ~H+  ~H+   coupling.
x12x0          |-2*L5                                                                                                          % W+.f W+.f ~H-  ~H-   coupling.
x13x0          |-(L1*v)                                                                                                        % Z.f  Z.f  h     coupling.
x14x0          |-(L1*v)                                                                                                        % W+.f W-.f h     coupling.
x15x0          |-3*L1*v                                                                                                        % h    h    h     coupling.
x16x0          |-(L3*v)                                                                                                        % h    ~H+  ~H-   coupling.
x17x0          |2                                                                                                              % a    a    W+.f W-.f  coupling.
x18x0          |2                                                                                                              % a    a    ~H+  ~H-   coupling.
x19x0          |-1                                                                                                             % a    W+.f W-.f  coupling.
x20x0          |-1                                                                                                             % a    ~H+  ~H-   coupling.
x21x0          |1                                                                                                              % a.C  W-.c W+    coupling.
x22x0          |-1                                                                                                             % a.C  W+.c W-    coupling.
x23x0          |-0.5*(v*pow(SW,-1))                                                                                            % W+.C a.c  W-.f  coupling.
x24x0          |1                                                                                                              % W+.C a.c  W-    coupling.
x25x0          |(v*pow(SW,-2))/4.                                                                                              % W+.C W-.c Z.f   coupling.
x26x0          |-0.25*(v*pow(SW,-2))                                                                                           % W+.C W-.c h     coupling.
x27x0          |-1                                                                                                             % W+.C W-.c a     coupling.
x28x0          |-(CW*pow(SW,-1))                                                                                               % W+.C W-.c Z     coupling.
x29x0          |-0.25*(v*pow(CW,-1)*(-1+pow(CW,2)*pow(SW,-2)))                                                                 % W+.C Z.c  W-.f  coupling.
x30x0          |CW*pow(SW,-1)                                                                                                  % W+.C Z.c  W-    coupling.
x31x0          |-0.5*(v*pow(SW,-1))                                                                                            % W-.C a.c  W+.f  coupling.
x32x0          |-1                                                                                                             % W-.C a.c  W+    coupling.
x33x0          |-0.25*(v*pow(SW,-2))                                                                                           % W-.C W+.c Z.f   coupling.
x34x0          |-0.25*(v*pow(SW,-2))                                                                                           % W-.C W+.c h     coupling.
x35x0          |1                                                                                                              % W-.C W+.c a     coupling.
x36x0          |CW*pow(SW,-1)                                                                                                  % W-.C W+.c Z     coupling.
x37x0          |-0.25*(v*pow(CW,-1)*(-1+pow(CW,2)*pow(SW,-2)))                                                                 % W-.C Z.c  W+.f  coupling.
x38x0          |-(CW*pow(SW,-1))                                                                                               % W-.C Z.c  W+    coupling.
x39x0          |(v*pow(CW,-1)*pow(SW,-2)*(pow(CW,2)+pow(SW,2)))/4.                                                             % Z.C  W-.c W+.f  coupling.
x40x0          |CW*pow(SW,-1)                                                                                                  % Z.C  W-.c W+    coupling.
x41x0          |(v*pow(CW,-1)*pow(SW,-2)*(pow(CW,2)+pow(SW,2)))/4.                                                             % Z.C  W+.c W-.f  coupling.
x42x0          |-(CW*pow(SW,-1))                                                                                               % Z.C  W+.c W-    coupling.
x43x0          |-0.25*(v*pow(CW,-2)*pow(SW,-2)*pow(pow(CW,2)+pow(SW,2),2))                                                     % Z.C  Z.c  h     coupling.
x44x0          |1                                                                                                              % g.C  g.c  g     coupling.
x45x0          |1                                                                                                              % g    g    g     coupling.
x46x           |-pow(2,-0.5)                                                                                                   % g    g    g        coupling.
x47x0          |-3*(2*L8*(pow(RR1x1,2)+pow(RR1x2,2))*pow(RR1x3,2)+L6*pow(RR1x3,4)+L2*pow(pow(RR1x1,2)+pow(RR1x2,2),2))           % ~H1  ~H1  ~H1  ~H1   coupling.
x48x0          |-3*(L2*(RR1x1*RR2x1+RR1x2*RR2x2)*(pow(RR1x1,2)+pow(RR1x2,2))+L8*RR1x3*(RR1x1*RR1x3*RR2x1+RR1x2*RR1x3*RR2x2+RR2x3*pow(RR1x1,2)+RR2x3*pow(RR1x2,2))+L6*RR2x3*pow(RR1x3,3))           % ~H1  ~H1  ~H1  ~H2   coupling.
x49x0          |-3*(L2*(RR1x1*RR3x1+RR1x2*RR3x2)*(pow(RR1x1,2)+pow(RR1x2,2))+L8*RR1x3*(RR1x1*RR1x3*RR3x1+RR1x2*RR1x3*RR3x2+RR3x3*pow(RR1x1,2)+RR3x3*pow(RR1x2,2))+L6*RR3x3*pow(RR1x3,3))           % ~H1  ~H1  ~H1  ~H3   coupling.
x50x0          |-(L2*(4*RR1x1*RR1x2*RR2x1*RR2x2+pow(RR1x1,2)*(3*pow(RR2x1,2)+pow(RR2x2,2))+pow(RR1x2,2)*(pow(RR2x1,2)+3*pow(RR2x2,2))))-3*L6*pow(RR1x3,2)*pow(RR2x3,2)-L8*(4*RR1x3*(RR1x1*RR2x1+RR1x2*RR2x2)*RR2x3+pow(RR1x3,2)*(pow(RR2x1,2)+pow(RR2x2,2))+(pow(RR1x1,2)+pow(RR1x2,2))*pow(RR2x3,2))           % ~H1  ~H1  ~H2  ~H2   coupling.
x51x0          |-(L2*(2*RR1x1*RR1x2*(RR2x2*RR3x1+RR2x1*RR3x2)+(3*RR2x1*RR3x1+RR2x2*RR3x2)*pow(RR1x1,2)+(RR2x1*RR3x1+3*RR2x2*RR3x2)*pow(RR1x2,2)))-3*L6*RR2x3*RR3x3*pow(RR1x3,2)-L8*(2*RR1x3*(RR1x1*RR2x3*RR3x1+RR1x2*RR2x3*RR3x2+RR1x1*RR2x1*RR3x3+RR1x2*RR2x2*RR3x3)+RR2x3*RR3x3*(pow(RR1x1,2)+pow(RR1x2,2))+(RR2x1*RR3x1+RR2x2*RR3x2)*pow(RR1x3,2))           % ~H1  ~H1  ~H2  ~H3   coupling.
x52x0          |-(L2*(4*RR1x1*RR1x2*RR3x1*RR3x2+pow(RR1x1,2)*(3*pow(RR3x1,2)+pow(RR3x2,2))+pow(RR1x2,2)*(pow(RR3x1,2)+3*pow(RR3x2,2))))-3*L6*pow(RR1x3,2)*pow(RR3x3,2)-L8*(4*RR1x3*(RR1x1*RR3x1+RR1x2*RR3x2)*RR3x3+pow(RR1x3,2)*(pow(RR3x1,2)+pow(RR3x2,2))+(pow(RR1x1,2)+pow(RR1x2,2))*pow(RR3x3,2))           % ~H1  ~H1  ~H3  ~H3   coupling.
